# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional override for the Gemini model ID used by server/geminiService.ts
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Operator Access Controls (server-side only)
# Comma-separated list of verified operator emails allowed to place LIVE broker orders and control Telegram bot
ADMIN_ALLOWED_EMAILS=""
# 32+ char secret used to encrypt persisted broker OAuth sessions (AES-256-GCM)
BROKER_SESSION_ENCRYPTION_KEY=""
# Android TWA Digital Asset Links config (served at /.well-known/assetlinks.json)
PLAYSTORE_PACKAGE_NAME="com.mytrade.terminal"
PLAYSTORE_SHA256_FINGERPRINT=""

# Optional server-side integrations (never exposed to browser)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Optional Trading App / Broker API & OAuth credentials (server-side only)
BROKER_API_KEY=""
BROKER_API_SECRET=""
GROWW_API_TOKEN=""
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_ACCESS_TOKEN=""
EXNESS_BRIDGE_URL=""
EXNESS_API_TOKEN=""
EXNESS_ACCOUNT_ID=""
EXNESS_SERVER=""
